# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (TimescaleDB / PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=valettrack
DB_PASSWORD=your_secure_password_here
DB_NAME=valettrack_db

# Frontend URL for CORS
CLIENT_ORIGIN=http://localhost:5174

# Facility Sensor Telemetry Ingestion Secret (Required in production, minimum 16 chars)
TELEMETRY_API_KEY=your_secure_telemetry_key_here
